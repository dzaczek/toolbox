# Example environment file for install-redis-ha.sh
#
# Copy this file, fill in real values, then load it before running the
# installer — install-redis-ha.sh reads every CONFIG_* value from the
# environment first and only falls back to its own built-in defaults when a
# variable isn't set (see the "CONFIGURATION" block at the top of the script).
#
# Usage on each of the 3 servers:
#   cp example.env redis-ha.env
#   nano redis-ha.env                     # fill in real password/IPs
#   set -a; source redis-ha.env; set +a
#   sudo -E ./install-redis-ha.sh          # -E preserves the environment across sudo
#
# Do not commit a filled-in redis-ha.env (it contains the cluster password in
# plain text) — keep example.env as the template and .gitignore the real one.

# ─────────────────────────────────────────────────────────────────────
# Redis password, base64-encoded. Generate with:
#   echo -n "YourStrongPasswordMin32Chars" | base64
# Must not be left as the placeholder below — the script refuses to run with it.
# ─────────────────────────────────────────────────────────────────────
# This is the script's own placeholder value — install-redis-ha.sh detects it
# and refuses to run, so you can't accidentally deploy with it unchanged.
CONFIG_PASS_B64="VE9KRV9TSUxORV9IQVNMT19UVVRBSg=="

# ─────────────────────────────────────────────────────────────────────
# IPs of the three servers
# ─────────────────────────────────────────────────────────────────────
CONFIG_IP_A="10.0.0.1"   # Redis (master) + Sentinel
CONFIG_IP_B="10.0.0.2"   # Redis (replica) + Sentinel
CONFIG_IP_C="10.0.0.3"   # Sentinel, plus Redis too if CONFIG_C_MODE=full below

# ─────────────────────────────────────────────────────────────────────
# Cluster name used by Sentinel and by clients (Kamailio, redis-py, ioredis, go-redis, ...)
# ─────────────────────────────────────────────────────────────────────
CONFIG_CLUSTER_NAME="mycluster"

# ─────────────────────────────────────────────────────────────────────
# Redis memory limit on every Redis node (A, B, and C if CONFIG_C_MODE=full).
# Size it to the actual server RAM — leave headroom for the OS, Sentinel, and
# fork() during a full replica resync. Roughly ~70% of total RAM is a
# reasonable starting point.
# ─────────────────────────────────────────────────────────────────────
CONFIG_MAXMEMORY="1400mb"

# ─────────────────────────────────────────────────────────────────────
# Server C's role:
#   sentinel-only  — lightweight arbiter, Sentinel only, no Redis data (default)
#   full           — C also runs Redis as a second replica of A (3 full Redis
#                    nodes + 3 Sentinels); size CONFIG_MAXMEMORY for C's real RAM too
# ─────────────────────────────────────────────────────────────────────
CONFIG_C_MODE="sentinel-only"
